# Copy to .env for local development. Every setting is documented in src/oasis/settings.py.
OASIS_LLM_BACKEND=fake
OASIS_STORAGE_BACKEND=sqlite
OASIS_DB_PATH=data/oasis.db
OASIS_LLM_URL=http://127.0.0.1:8080
# Optional ML models (docs/ml_models.md). The crisis classifier is on by default; the NLI
# check and psychoeducation retrieval switch on when their model folders exist.
OASIS_CRISIS_CLASSIFIER=1
OASIS_GUARD_NLI_DIR=models/nli
OASIS_PSYCHOED_EMBED_DIR=models/embed
